<?xml version="1.0" encoding="ASCII"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" name="runningdinnermetamodel" nsURI="platform:/resource/runningdinnermetamodel/model/Runningdinnermetamodel.ecore"
    nsPrefix="runningdinnermetamodel">
  <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
    <details key="documentation" value="TODO: Add documentation for runningdinnermetamodel. Hint: You may copy this element in the Ecore editor to add documentation to EClasses, EOperations, ..."/>
  </eAnnotations>
  <eClassifiers xsi:type="ecore:EClass" name="Root">
    <eStructuralFeatures xsi:type="ecore:EReference" name="teams" upperBound="-1"
        eType="#//Team" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="groups" upperBound="-1"
        eType="#//Group" containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Team">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="hosts" lowerBound="1" eType="#//Course"
        containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="isGuestAt" lowerBound="2"
        upperBound="2" eType="#//Course"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="group" lowerBound="1" eType="#//Group"
        containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="foodAllergies" upperBound="-1"
        eType="#//FoodAllergies" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="environment" upperBound="-1"
        eType="#//Environment" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="environmentalAllergies"
        upperBound="-1" eType="#//EnvironmentalAllergies" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="Language" upperBound="-1"
        eType="#//Language"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="eatingHabit" eType="#//EatingHabit"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Course">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="Speise" lowerBound="1"
        eType="#//Speise"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="KitchenPosition" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="Speise">
    <eLiterals name="Vorspeise"/>
    <eLiterals name="Hauptspeise" value="1"/>
    <eLiterals name="Nachspeise" value="2"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Group">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="Name" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="Size" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        defaultValueLiteral="9"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="Teams" upperBound="-1"
        eType="#//Team" containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="FoodAllergies"/>
  <eClassifiers xsi:type="ecore:EClass" name="Environment">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="criticalAllergies" eType="#//CriticalAllergies"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="EnvironmentalAllergies">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="criticalAllergies" eType="#//CriticalAllergies"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="Language">
    <eLiterals name="german"/>
    <eLiterals name="english" value="1"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Kitchen">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="Koordinaten">
      <eGenericType eClassifier="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EEList">
        <eTypeArguments/>
      </eGenericType>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="CriticalAllergies">
    <eLiterals name="Hunde"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="EatingHabit">
    <eLiterals name="vegan"/>
    <eLiterals name="vegetarian" value="1"/>
  </eClassifiers>
</ecore:EPackage>
