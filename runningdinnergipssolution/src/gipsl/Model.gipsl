package "gipsl"
import "platform:/resource/runningdinnermetamodel/model/Runningdinnermetamodel.ecore"

config {  
	solver := GUROBI;
	timeLimit := true [value := 300.0];
	randomSeed := true [value := 0];
	presolve := auto;
	debugOutput := true;
	lpOutput := true [path := "./gurobi.lp"];
}

rule assignTeamToGroup {
	t : Team {
		++ -group -> p
	}
	
	p : Group
}

mapping teamToGroupAssignment to assignTeamToGroup;

//Every Team is in exactly one group
constraint with Team {
	mappings.teamToGroupAssignment->filter(element.nodes.t == context)->sum(element.value) == 1
}

rule courseIsStarter {
	c : Course {
		.meal := "Starter"
	}
}
mapping courseStarterAssignment to courseIsStarter;

rule courseIsMain {
	c : Course {
		.meal := "Main"
	}
}
mapping courseMainAssignment to courseIsMain;

rule courseIsDessert {
	c : Course {
		.meal := "Dessert"
	}
}
mapping courseDessertAssignment to courseIsDessert;
//Every Course has only one meal don't know if this is really necessary?
constraint with Course {
	mappings.courseStarterAssignment->filter(element.nodes.c == context)->sum(element.value)
	+ mappings.courseMainAssignment->filter(element.nodes.c == context)->sum(element.value)
	+ mappings.courseDessertAssignment->filter(element.nodes.c == context)->sum(element.value)
	== 1
}
//number of starter == number of Main == Number of Dessert
constraint {
	mappings.courseStarterAssignment->sum(element.value) ==
	mappings.courseMainAssignment->sum(element.value)
	
	&
	mappings.courseStarterAssignment->sum(element.value) ==
	mappings.courseDessertAssignment->sum(element.value)
}

//____________________________________________

rule teamIsGuestAtStarter {
	t : Team {
		++ -isGuestAt -> c
		-way -> w
	}
	
	h : Team {
		-hosts -> c
	}
	
	c : Course 
	
	w : Way {
		-destination -> h
	}
}

mapping guestAtStarter to teamIsGuestAtStarter;

rule teamIsGuestAtMain {
	t : Team {
		++ -isGuestAt -> c
		-way -> w
	}
	
	h : Team {
		-hosts -> c
	}
	
	c : Course 
	
	w : Way {
		-destination -> h
	}
}

mapping guestAtMain to teamIsGuestAtMain;

rule teamIsGuestAtDessert {
	t : Team {
		++ -isGuestAt -> c
		-way -> w
	}
	
	h : Team {
		-hosts -> c
	}
	
	c : Course 
	
	w : Way {
		-destination -> h
	}
}


mapping guestAtDessert to teamIsGuestAtDessert;


//Every Starter Course has exactly two guets
constraint with Course { 
	mappings.guestAtStarter->filter(element.nodes.c == context)->sum(element.value) == 
	2 * mappings.courseStarterAssignment->filter(element.nodes.c == context)->sum(element.value)
}
//Every Mian Course has exactly two guets
constraint with Course { 
	mappings.guestAtMain->filter(element.nodes.c == context)->sum(element.value) == 
	2 * mappings.courseMainAssignment->filter(element.nodes.c == context)->sum(element.value)
}
//Every Dessert Course has exactly two guets
constraint with Course { 
	mappings.guestAtDessert->filter(element.nodes.c == context)->sum(element.value) == 
	2 * mappings.courseDessertAssignment->filter(element.nodes.c == context)->sum(element.value)
}
//Every Team visits exactly one Starter as a guest or a host
constraint with Team { 
	mappings.courseStarterAssignment->filter(element.nodes.c == context.hosts)->sum(element.value) + 
	mappings.guestAtStarter->filter(element.nodes.t == context)->sum(element.value) == 1
}
//Every Team visits exactly one Main as a guest or a host
constraint with Team { 
	mappings.courseMainAssignment->filter(element.nodes.c == context.hosts)->sum(element.value) + 
	mappings.guestAtMain->filter(element.nodes.t == context)->sum(element.value) == 1
}
//Every Team visits exactly one Dessert as a guest or a host
constraint with Team { 
	mappings.courseDessertAssignment->filter(element.nodes.c == context.hosts)->sum(element.value) + 
	mappings.guestAtDessert->filter(element.nodes.t == context)->sum(element.value) == 1
}
//____________________________________________

pattern guestHostPair {
	t1 : Team
	t2 : Team
}


pattern guestGuestPair {
	t1 : Team{
		-isGuestAt -> c
	}
	
	t2 : Team{
		-isGuestAt -> c
	}
	
	c : Course
}

mapping guestGuestPairs to guestGuestPair;

constraint with guestHostPair {
	//Sum of every time two pairs meet as guest and host
	mappings.guestAtStarter->filter(
		element.nodes.t == context.nodes.t1 & element.nodes.h == context.nodes.t2 |
		element.nodes.t == context.nodes.t2 & element.nodes.h == context.nodes.t1)->sum(element.value) +
	mappings.guestAtMain->filter(
		element.nodes.t == context.nodes.t1 & element.nodes.h == context.nodes.t2 |
		element.nodes.t == context.nodes.t2 & element.nodes.h == context.nodes.t1)->sum(element.value) +
	mappings.guestAtDessert->filter(
		element.nodes.t == context.nodes.t1 & element.nodes.h == context.nodes.t2 |
		element.nodes.t == context.nodes.t2 & element.nodes.h == context.nodes.t1)->sum(element.value) +
	//Sum of every time two pairs meet as guests	
	mappings.guestGuestPairs->filter(
		element.nodes.t1 == context.nodes.t1 & 
		element.nodes.t2 == context.nodes.t2)->sum(element.value)
	<= 1
}

//constraint with guestGuestPair {
//	mappings.guestAtStarter->filter(
//		element.nodes.t == context.nodes.t1 & element.nodes.h == context.nodes.t2 & element.nodes.c == context.nodes.c)->sum(element.value) +
//	mappings.guestAtMain->filter(
//		element.nodes.t == context.nodes.t1 & element.nodes.h == context.nodes.t2 & element.nodes.c == context.nodes.c)->sum(element.value) +
//	mappings.guestAtDessert->filter(
//		element.nodes.t == context.nodes.t1 & element.nodes.h == context.nodes.t2 & element.nodes.c == context.nodes.c)->sum(element.value) 
//	== 1
//}


//function to sum up every distances
function totalDistance with Team {
	mappings.guestAtStarter->filter(element.nodes.t == context)->sum(element.value * element.nodes.w.distance * 10) +
	mappings.guestAtMain->filter(element.nodes.t == context)->sum(element.value * element.nodes.w.distance * 10) +
	mappings.guestAtDessert->filter(element.nodes.t == context)->sum(element.value * element.nodes.w.distance * 10)
}


objective : min {
	functions.totalDistance
}